{
  "name": "ketjs-monorepo",
  "private": true,
  "version": "0.1.41",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/ketjs-view",
    "packages/ketjs-view-tools",
    "packages/create-view",
    "packages/ketjs",
    "packages/ketjs-postgres"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "node tools/build.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node --test --test-timeout=120000 --test-force-exit \".build/test/*.test.js\"",
    "test:built": "node --test --test-timeout=120000 --test-force-exit \".build/test/*.test.js\"",
    "bench:i18n": "npm run build --silent && node .build/bench/i18n.bench.js",
    "bench:modules": "npm run build --silent && node .build/bench/module-path.bench.js",
    "bench:queue": "npm run build --silent && node .build/bench/queue.bench.js",
    "audit:zero-dep": "npm run build --silent && node .build/tools/zero-dep-audit.js",
    "audit:terminology": "node tools/terminology-audit.mjs",
    "release:check": "npm run verify && node tools/release.mjs check",
    "release:pack": "npm run build --silent && node tools/release.mjs pack",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "verify": "node tools/ci-task-cache.mjs run format && node tools/ci-task-cache.mjs run lint && npm run audit:terminology && npm run build && node .build/tools/zero-dep-audit.js && node tools/ci-task-cache.mjs run types && npm run test:built",
    "ket": "npm run build --silent && node packages/ketjs/dist/cli.js",
    "test:one": "npm run build --silent && node tools/test-one.mjs",
    "ci:task": "node tools/ci-task-cache.mjs run",
    "bench": "npm run build --silent && node .build/bench/view.bench.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^26.2.0",
    "tsx": "4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
