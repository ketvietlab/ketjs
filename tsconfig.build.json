{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": ".build",
    "declaration": false,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["packages/*/src/**/*", "test/**/*", "tools/**/*.ts", "bench/**/*"],
  "exclude": [".build", "packages/*/dist", "node_modules", "bench/form-comparison"]
}
