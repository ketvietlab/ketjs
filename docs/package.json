{
  "name": "@ketsuite/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate:api": "npm --prefix .. run build --silent && node ../tools/generate-channel-openapi.mjs --output public/api/customer-v1.openapi.json && ../node_modules/.bin/biome format --write public/api/customer-v1.openapi.json",
    "predev": "npm run generate:api",
    "prebuild": "npm run generate:api",
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.4",
    "astro-mermaid": "2.1.0",
    "mermaid": "11.17.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
