{
  "name": "ketjs",
  "version": "0.0.0",
  "description": "Ket — a zero-dependency, module-composable, theme-driven fullstack framework for Node.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    }
  },
  "bin": {
    "ket": "./dist/cli.js"
  },
  "dependencies": {
    "ketjs-view": "0.0.0"
  },
  "files": [
    "dist"
  ]
}
