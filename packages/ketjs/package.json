{
  "name": "@ketvietlab/ketjs",
  "version": "0.1.3",
  "description": "Ket — a zero-dependency, module-composable, theme-driven fullstack framework for Node.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketvietlab/ketjs.git",
    "directory": "packages/ketjs"
  },
  "homepage": "https://github.com/ketvietlab/ketjs#readme",
  "bugs": {
    "url": "https://github.com/ketvietlab/ketjs/issues"
  },
  "keywords": [
    "framework",
    "fullstack",
    "ssr",
    "islands",
    "typescript",
    "sqlite"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepack": "npm run build --prefix ../.."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf/index.d.ts",
      "default": "./dist/pdf/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "bin": {
    "ket": "dist/cli.js"
  },
  "dependencies": {
    "@ketvietlab/ketjs-view": "0.1.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ]
}
