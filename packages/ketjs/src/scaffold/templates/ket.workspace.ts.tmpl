import { defineDeployment, json } from '@ketvietlab/ketjs'
import __NAME__ from './modules/__NAME__.ts'

// A deployment is the complete module composition that migrates and runs.
export const deployment = defineDeployment({
  name: '__NAME__',
  modules: [__NAME__],
  headless: true,
  serve: {
    routes: (ctx) => ({
      '/': async (url, req) => json(await ctx.call('__NAME__.list', {}, url, req)),
    }),
  },
})

export const deployments = [deployment]
