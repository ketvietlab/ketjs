<section class="hero" data-ket-section="hero">
  {% if image %}<img class="hero-image" src="{{ image }}" alt="">{% endif %}
  <div class="hero-copy"><p class="eyebrow">A considered stay</p><h1>{{ heading }}</h1>
  {% if subheading %}<p>{{ subheading }}</p>{% endif %}
  {% if ctaLabel %}<a class="cta" href="{{ ctaHref | default: '#' }}">{{ ctaLabel }}</a>{% endif %}</div>
</section>
