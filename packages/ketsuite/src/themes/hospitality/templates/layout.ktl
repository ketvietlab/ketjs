<!doctype html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.title }}</title>
  <link rel="stylesheet" href="/_ket/asset/theme_hospitality/theme.css">
  {% joint "website:page.head" %}
</head>
<body class="hospitality-site">
  <header class="site-masthead"><a class="site-wordmark" href="/">{{ site.title }}</a></header>
  {% joint "website:page.body.start" %}
  <main data-ket-slot="website.page">{% region "website.page" %}</main>
  {% joint "website:page.body.end" %}
  <footer class="site-footer">{{ site.title }}</footer>
</body>
</html>
