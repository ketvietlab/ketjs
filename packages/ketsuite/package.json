{
  "name": "@ketvietlab/ketsuite",
  "version": "0.1.1",
  "description": "KetSuite — business modules built on Ket, using only the contract a third-party module has.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketvietlab/ketjs.git",
    "directory": "packages/ketsuite"
  },
  "homepage": "https://github.com/ketvietlab/ketjs#readme",
  "bugs": {
    "url": "https://github.com/ketvietlab/ketjs/issues"
  },
  "keywords": [
    "erp",
    "business",
    "modules",
    "ketjs",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepack": "npm run build --prefix ../.."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./backend": {
      "types": "./dist/modules/backend/index.d.ts",
      "default": "./dist/modules/backend/index.js"
    }
  },
  "dependencies": {
    "@ketvietlab/ketjs": "0.1.1",
    "@ketvietlab/ketjs-view": "0.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ]
}
