{
  "name": "@ketvietlab/ketsuite",
  "version": "0.1.3",
  "description": "KetSuite — business modules built on Ket, using only the contract a third-party module has.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ketsuite": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketvietlab/ketjs.git",
    "directory": "packages/ketsuite"
  },
  "homepage": "https://github.com/ketvietlab/ketjs#readme",
  "bugs": {
    "url": "https://github.com/ketvietlab/ketjs/issues"
  },
  "keywords": [
    "erp",
    "business",
    "modules",
    "ketjs",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepack": "npm run build --prefix ../.."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./deployment": {
      "types": "./dist/deployment.d.ts",
      "default": "./dist/deployment.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./backend": {
      "types": "./dist/modules/backend/index.d.ts",
      "default": "./dist/modules/backend/index.js"
    }
  },
  "dependencies": {
    "@ketvietlab/ketjs": "0.1.3",
    "@ketvietlab/ketjs-view": "0.1.3",
    "chart.js": "4.5.1",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ]
}
