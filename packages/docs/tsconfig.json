{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@ketvietlab/ketjs-view",
    "types": ["node"]
  },
  "include": ["site/**/*.ts", "site/**/*.tsx", "pages/**/*.tsx", "ket-view.config.ts"]
}
