{
  "name": "@ketvietlab/ketjs-docs",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "ket-view dev",
    "build": "ket-view build && node site/verify.mjs",
    "preview": "ket-view preview --host 127.0.0.1 --port 3700",
    "check": "tsc --noEmit && ket-view check",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ketvietlab/design-system": "0.1.41",
    "@ketvietlab/ketjs-view": "0.4.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@ketvietlab/ketjs-view-tools": "0.4.0",
    "@lezer/highlight": "1.2.5",
    "@mermaid-js/tiny": "12.1.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "esbuild-wasm": "0.28.2",
    "fflate": "0.8.3",
    "marked": "15.0.12",
    "sanitize-html": "2.18.0",
    "shiki": "3.13.0",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@ketvietlab/design-system": {
      "@ketvietlab/ketjs-view": "$@ketvietlab/ketjs-view"
    }
  }
}
