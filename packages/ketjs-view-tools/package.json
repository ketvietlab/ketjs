{
  "name": "@ketvietlab/ketjs-view-tools",
  "version": "0.2.0",
  "description": "Static-site development and build tools for ketjs-view.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ket-view": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketvietlab/ketjs.git",
    "directory": "packages/ketjs-view-tools"
  },
  "homepage": "https://github.com/ketvietlab/ketjs#readme",
  "bugs": {
    "url": "https://github.com/ketvietlab/ketjs/issues"
  },
  "keywords": [
    "static-site",
    "ssg",
    "islands",
    "ketjs",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepack": "npm run build --prefix ../..",
    "build": "tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ketvietlab/ketjs-view": "0.2.0",
    "acorn": "8.19.0",
    "acorn-jsx": "5.3.2",
    "esbuild": "0.28.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ]
}
