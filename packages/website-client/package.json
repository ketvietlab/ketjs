{
  "name": "@ketvietlab/website-client",
  "version": "0.1.37",
  "type": "module",
  "license": "MIT",
  "description": "Website Studio CSR client and server extension contracts for KetSuite.",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/extensions.d.ts",
      "default": "./dist/server/extensions.js"
    },
    "./styles.css": "./dist/client/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "CONTRACT.md",
    "API-CONTRACT.md",
    "EXTENSIONS.md",
    "README.md"
  ],
  "dependencies": {
    "@ketvietlab/ketjs-view": "0.1.37",
    "@ketvietlab/design-system": "0.1.37",
    "@ketvietlab/ketsuite": "0.1.37"
  },
  "main": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketvietlab/ketjs.git",
    "directory": "packages/website-client"
  },
  "homepage": "https://github.com/ketvietlab/ketjs#readme",
  "bugs": {
    "url": "https://github.com/ketvietlab/ketjs/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "npm run build --prefix ../.."
  }
}
