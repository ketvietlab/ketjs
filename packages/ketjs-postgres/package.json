{
  "name": "@ketvietlab/ketjs-postgres",
  "version": "0.1.2",
  "description": "Postgres adapter for Ket. The one package permitted a dependency (decision D4a) — which is why it is a package.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketvietlab/ketjs.git",
    "directory": "packages/ketjs-postgres"
  },
  "homepage": "https://github.com/ketvietlab/ketjs#readme",
  "bugs": {
    "url": "https://github.com/ketvietlab/ketjs/issues"
  },
  "keywords": [
    "postgresql",
    "database",
    "adapter",
    "ketjs",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepack": "npm run build --prefix ../.."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ketvietlab/ketjs": "0.1.2"
  },
  "peerDependencies": {
    "postgres": "^3.4.9"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "postgres": "^3.4.9"
  }
}
