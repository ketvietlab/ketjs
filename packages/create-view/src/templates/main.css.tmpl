:root {
  color: #17201b;
  background: #f3f0e8;
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  font-synthesis: none;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 20rem; }
a { color: inherit; text-underline-offset: 0.2em; }
.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: min(72rem, calc(100% - 3rem));
  margin: 0 auto;
  padding: 1.5rem 0;
  border-bottom: 1px solid #c7c2b6;
}
.brand { font-weight: 750; text-decoration: none; }
main { width: min(72rem, calc(100% - 3rem)); margin: 0 auto; }
.hero, .prose { max-width: 52rem; padding: clamp(5rem, 12vw, 10rem) 0; }
.eyebrow { color: #3e6b51; font-size: 0.82rem; font-weight: 750; letter-spacing: 0.12em; text-transform: uppercase; }
h1 { margin: 0.5rem 0 1.5rem; font-family: Georgia, serif; font-size: clamp(3rem, 7vw, 6.8rem); font-weight: 500; letter-spacing: -0.055em; line-height: 0.92; }
.prose h1 { font-size: clamp(3rem, 6vw, 5rem); }
.lede, .prose p { max-width: 40rem; font-size: clamp(1.05rem, 2vw, 1.3rem); line-height: 1.65; }
.counter { display: flex; align-items: center; gap: 1rem; width: fit-content; margin-top: 2.5rem; padding: 0.55rem 0.6rem 0.55rem 1.1rem; color: #f8f6ef; background: #17201b; border-radius: 999px; }
button { padding: 0.7rem 1rem; color: #17201b; background: #d7f26c; border: 0; border-radius: 999px; font: inherit; font-weight: 750; cursor: pointer; }
code { padding: 0.12em 0.35em; background: #e4dfd3; border-radius: 0.25rem; }

@media (max-width: 40rem) {
  .site-header, main { width: min(100% - 2rem, 72rem); }
  .hero, .prose { padding: 4rem 0; }
}
