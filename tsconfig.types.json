{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "packages",
    "outDir": ".types",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "packages/*/src/**/*",
    "packages/website-client/client/**/*",
    "packages/website-client/server/**/*"
  ],
  "exclude": ["packages/*/dist", "node_modules"]
}
