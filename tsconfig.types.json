{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "packages",
    "outDir": ".types",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["packages/*/src/**/*"],
  "exclude": ["packages/*/dist", "node_modules"]
}
