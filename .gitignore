# esbuild output for the Live Doc editor — regenerated by
# tools/build-flow-client.mjs on every build, never hand-edited. Everything
# else in src/ui/client (the .css, the hand-written .mjs, the .tsx island
# sources) is authored and stays tracked.
packages/ketsuite/src/ui/client/live-doc.mjs
packages/ketsuite/src/ui/client/live-doc.mjs.map
# Typed backend islands are authored under src/ui/client and emitted into the
# backend asset root by tools/build-backend-client.mjs.
packages/ketsuite/src/modules/backend/design/client/relation-select.mjs
packages/ketsuite/src/modules/backend/design/client/relation-select.mjs.map
packages/ketsuite/src/modules/backend/design/client/table-selection.mjs
packages/ketsuite/src/modules/backend/design/client/table-selection.mjs.map
coverage/
.release/
*.tsbuildinfo

